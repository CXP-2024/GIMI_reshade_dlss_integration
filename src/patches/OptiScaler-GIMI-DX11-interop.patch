+namespace
+{
+using ReShadeCreateEffectRuntime = bool (*)(uint32_t api, void* device, void* commandQueue, void* swapChain,
+                                            const char* configPath, void** runtime);
+using ReShadeUpdateAndPresentEffectRuntime = void (*)(void* runtime);
+
+constexpr uint32_t kReShadeD3D11Api = 0xb000;
+
+class ReShadeManualRuntime
+{
+public:
+    void Present(IDXGISwapChain* swapChain)
+    {
+        if (!Config::Instance()->LoadReShade.value_or_default() || swapChain == nullptr)
+            return;
+
+        std::scoped_lock lock(_mutex);
+
+        if (_runtime == nullptr && !_initializationFailed)
+            Initialize(swapChain);
+
+        if (_runtime != nullptr)
+            _present(_runtime);
+    }
+
+private:
+    void Initialize(IDXGISwapChain* swapChain)
+    {
+        if (reshadeModule == nullptr)
+            return;
+
+        const auto create = reinterpret_cast<ReShadeCreateEffectRuntime>(
+            GetProcAddress(reshadeModule, "ReShadeCreateEffectRuntime"));
+        _present = reinterpret_cast<ReShadeUpdateAndPresentEffectRuntime>(
+            GetProcAddress(reshadeModule, "ReShadeUpdateAndPresentEffectRuntime"));
+
+        if (create == nullptr || _present == nullptr)
+        {
+            _initializationFailed = true;
+            LOG_ERROR("ReShade manual runtime exports are unavailable");
+            return;
+        }
+
+        ID3D11Device* device = nullptr;
+        ID3D11DeviceContext* context = nullptr;
+        const HRESULT deviceResult = swapChain->GetDevice(IID_PPV_ARGS(&device));
+
+        if (SUCCEEDED(deviceResult) && device != nullptr)
+            device->GetImmediateContext(&context);
+
+        if (device == nullptr || context == nullptr)
+        {
+            _initializationFailed = true;
+            LOG_ERROR("ReShade manual runtime could not obtain the D3D11 device/context: {:X}",
+                      static_cast<UINT>(deviceResult));
+            if (context != nullptr)
+                context->Release();
+            if (device != nullptr)
+                device->Release();
+            return;
+        }
+
+        const auto configPath = wstring_to_string((Util::ExePath().parent_path() / L"ReShade.ini").wstring());
+        const bool created = create(kReShadeD3D11Api, device, context, swapChain, configPath.c_str(), &_runtime);
+
+        context->Release();
+        device->Release();
+
+        if (!created || _runtime == nullptr)
+        {
+            _runtime = nullptr;
+            _initializationFailed = true;
+            LOG_ERROR("ReShade manual runtime initialization failed");
+            return;
+        }
+
+        LOG_INFO("ReShade manual runtime initialized on OptiScaler Present path");
+    }
+
+    std::mutex _mutex;
+    void* _runtime = nullptr;
+    ReShadeUpdateAndPresentEffectRuntime _present = nullptr;
+    bool _initializationFailed = false;
+};
+
+ReShadeManualRuntime g_reShadeManualRuntime;
+}
