+// 3DMigoto/GIMI exposes its D3D11 wrapper through this private interface.
+// NGX validates the identity of the D3D11 device/context during feature
+// creation, so passing the wrapper directly makes native DLSS return
+// NVSDK_NGX_Result_FAIL_NotInitialized (BAD00007).
+static constexpr GUID kGimiHackerDevice = {0x83ffd841,
+                                           0xa5c9,
+                                           0x46f4,
+                                           {0x81, 0x09, 0xbc, 0x25, 0x95, 0x58, 0xfe, 0xf4}};
+
+static bool IsGimiDevice(ID3D11Device* device)
+{
+    if (device == nullptr)
+        return false;
+
+    IUnknown* marker = nullptr;
+    const auto result = device->QueryInterface(kGimiHackerDevice, reinterpret_cast<void**>(&marker));
+    if (SUCCEEDED(result) && marker != nullptr)
+    {
+        marker->Release();
+        return true;
+    }
+
+    return false;
