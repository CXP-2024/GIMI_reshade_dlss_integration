+
+struct NativeD3D11Context
+{
+    ID3D11DeviceContext4* context4 = nullptr;
+    ID3D11Device* device = nullptr;
+
+    NativeD3D11Context() = default;
+    NativeD3D11Context(const NativeD3D11Context&) = delete;
+    NativeD3D11Context& operator=(const NativeD3D11Context&) = delete;
+
+    NativeD3D11Context(NativeD3D11Context&& other) noexcept
+        : context4(other.context4), device(other.device)
+    {
+        other.context4 = nullptr;
+        other.device = nullptr;
+    }
+
+    NativeD3D11Context& operator=(NativeD3D11Context&& other) noexcept
+    {
+        if (this != &other)
+        {
+            Reset();
+            context4 = other.context4;
+            device = other.device;
+            other.context4 = nullptr;
+            other.device = nullptr;
+        }
+        return *this;
+    }
+
+    ~NativeD3D11Context() { Reset(); }
+
+    void Reset()
+    {
+        if (device != nullptr)
+        {
+            device->Release();
+            device = nullptr;
+        }
+        if (context4 != nullptr)
+        {
+            context4->Release();
+            context4 = nullptr;
+        }
+    }
+
+    ID3D11DeviceContext* Context() const { return reinterpret_cast<ID3D11DeviceContext*>(context4); }
+};
