diff --git a/source/addon.cpp b/source/addon.cpp
index 105d9eef5d70102e853d4d2803be43e8c9d6178a..9a71e07dc84db598596a20fc711f966ec89c3543 100644
--- a/source/addon.cpp
+++ b/source/addon.cpp
@@ -267,9 +267,21 @@ void ReShadeUpdateAndPresentEffectRuntime(reshade::api::effect_runtime *runtime)
 	if (runtime == nullptr)
 		return;
 
+	// A runtime created through the public hosting API has no DXGI wrapper to
+	// dispatch the ordinary per-frame add-on events. Mirror the relevant part of
+	// DXGISwapChain::on_present here so add-ons can advance frame-local state
+	// (for example RenoDX's one-pass-per-output mask) even when another injector
+	// deliberately remains the sole owner of the real swap chain.
+	reshade::api::command_queue *const queue = runtime->get_command_queue();
+	reshade::api::swapchain *const swapchain = static_cast<reshade::runtime *>(runtime)->get_swapchain();
+	reshade::invoke_addon_event<reshade::addon_event::execute_command_list>(
+		queue, queue->get_immediate_command_list());
+	reshade::invoke_addon_event<reshade::addon_event::present>(
+		queue, swapchain, nullptr, nullptr, 0, nullptr);
+
 	static_cast<reshade::runtime *>(runtime)->on_present();
 
-	runtime->get_command_queue()->flush_immediate_command_list();
+	queue->flush_immediate_command_list();
 }
 
 #endif
diff --git a/source/dxgi/dxgi_swapchain.cpp b/source/dxgi/dxgi_swapchain.cpp
index ce7d6acb0bd01edde2d72845a36acd3696e6dc40..6012e465ac40dc7ebdf17353794a46d625a3ae04 100644
--- a/source/dxgi/dxgi_swapchain.cpp
+++ b/source/dxgi/dxgi_swapchain.cpp
@@ -404,6 +404,21 @@ HRESULT STDMETHODCALLTYPE DXGISwapChain::ResizeBuffers(UINT BufferCount, UINT Wi
 		_orig->GetDesc(&desc);
 		g_in_dxgi_runtime = was_in_dxgi_runtime;
 
+		// GIMI exposes the game's HDR swap chain as R10G10B10A2, but its
+		// wrapper rejects the resize parameters ReShade normally uses
+		// (one buffer and an sRGB format). Keep the original HDR contract in
+		// ReShade's descriptor as well, so HDR-aware effects continue to see
+		// the correct colour space after the resize.
+		const bool preserve_hdr_swapchain =
+			desc.BufferDesc.Format == DXGI_FORMAT_R10G10B10A2_UNORM &&
+			(NewFormat != DXGI_FORMAT_UNKNOWN && NewFormat != DXGI_FORMAT_R10G10B10A2_UNORM);
+		if (preserve_hdr_swapchain)
+		{
+			NewFormat = DXGI_FORMAT_UNKNOWN;
+			if (desc.BufferCount >= 2 && BufferCount != 0 && BufferCount < 2)
+				BufferCount = desc.BufferCount;
+		}
+
 		// Restore default parameters to tho original values, rather than leaving them at the last values potentially overridden by an add-on
 		if (0 == BufferCount)
 			BufferCount = _orig_desc.BufferCount;
