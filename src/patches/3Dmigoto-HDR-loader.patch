+++ b/Injector/Injector.cpp
@@ -10,6 +10,38 @@
 #include <tlhelp32.h>
 #include <set>
 
+static void diagnostic_log(const char *message)
+{
+	char executable_path[MAX_PATH], line[512];
+	char *separator;
+	HANDLE file;
+	DWORD written;
+	SYSTEMTIME timestamp;
+
+	if (!GetModuleFileNameA(NULL, executable_path, MAX_PATH))
+		return;
+
+	separator = strrchr(executable_path, '\\');
+	if (!separator)
+		return;
+
+	*separator = '\0';
+	strcat_s(executable_path, "\\3DMigotoLoader-debug.log");
+	GetLocalTime(&timestamp);
+	sprintf_s(line, "%04u-%02u-%02u %02u:%02u:%02u | %s\\r\\n",
+		timestamp.wYear, timestamp.wMonth, timestamp.wDay,
+		timestamp.wHour, timestamp.wMinute, timestamp.wSecond, message);
+
+	file = CreateFileA(executable_path, FILE_APPEND_DATA,
+		FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_ALWAYS,
+		FILE_ATTRIBUTE_NORMAL, NULL);
+	if (file == INVALID_HANDLE_VALUE)
+		return;
+
+	WriteFile(file, line, (DWORD)strlen(line), &written, NULL);
+	CloseHandle(file);
+}
+
